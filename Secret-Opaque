apiVersion: v1
kind: Secret
metadata:
  name: app-secret

type: Opaque

stringData:
  DB_USERNAME: "admin"
  DB_PASSWORD: "test123456"

---
apiVersion: v1
kind: Pod
metadata:
  name: nginx-secret-pod

spec:
  containers:
    - name: nginx
      image: nginx:stable

      ports:
        - containerPort: 80

      # Method 1: Environment Variables
      env:
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              name: app-secret
              key: DB_USERNAME

        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: app-secret
              key: DB_PASSWORD

      # Method 2: Secret as Files
      volumeMounts:
        - name: secret-volume
          mountPath: /etc/app-secrets
          readOnly: true

  volumes:
    - name: secret-volume
      secret:
        secretName: app-secret
