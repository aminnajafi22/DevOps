apiVersion: batch/v1
kind: Job
metadata:
  name: nginx-job

spec:
  completions: 1
  parallelism: 1
  backoffLimit: 3

  template:
    spec:
      restartPolicy: Never

      containers:
        - name: nginx
          image: nginx:stable
          command:
            - /bin/sh
            - -c
          args:
            - |
              echo "Starting Nginx configuration test"
              nginx -t
              echo "Job completed"
