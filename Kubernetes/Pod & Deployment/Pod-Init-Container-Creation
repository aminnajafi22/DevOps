
apiVersion: v1
kind: Pod
metadata:
  name: nginx-with-init
  namespace: devops
  labels:
    app: nginx
spec:
  initContainers:
    - name: init-html
      image: busybox:1.36
      command:
        - sh
        - -c
        - |
          echo "Hello from Init Container!" > /usr/share/nginx/html/index.html
      volumeMounts:
        - name: html-volume
          mountPath: /usr/share/nginx/html

  containers:
    - name: nginx
      image: nginx:alpine
      ports:
        - containerPort: 80
      volumeMounts:
        - name: html-volume
          mountPath: /usr/share/nginx/html

  volumes:
    - name: html-volume
      emptyDir: {}
