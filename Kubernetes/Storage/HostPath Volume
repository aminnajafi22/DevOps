apiVersion: v1
kind: Pod
metadata:
  name: mysql-pod

spec:
  containers:
    - name: mysql
      image: mysql:8.4

      env:
        - name: MYSQL_ROOT_PASSWORD
          value: "test123456"

      volumeMounts:
        - name: mysql-storage
          mountPath: /var/lib/mysql

  volumes:
    - name: mysql-storage
      hostPath:
        path: /data/mysql
        type: DirectoryOrCreate
